# Leave blank for the self-contained local game. The future shared account
# service implements the contract in docs/shared-accounts.md.
VITE_ACCOUNT_API_URL=

# Build at / today, or set /euchre/ when hosted beneath cards.shmem.dev.
VITE_BASE_PATH=/

# Optional local proxy target when developing against the shared account service.
ACCOUNT_PROXY_TARGET=
