# Required only when installing/building the Font Awesome Pro dependencies.
FONTAWESOME_PACKAGE_TOKEN=

# Dev defaults to /api/account; production builds need this set explicitly.
VITE_ACCOUNT_API_URL=
VITE_BASE_PATH=/
# Direct Vite defaults to http://127.0.0.1:5000.
# Docker dev defaults to http://host.docker.internal:5000.
ACCOUNT_PROXY_TARGET=
